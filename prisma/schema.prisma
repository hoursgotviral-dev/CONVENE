datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
}

model Room {
  id           String   @id @default(uuid())
  code         String   @unique
  createdBy    String
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  status   String
}

model Task {
  id                String   @id @default(uuid())
  roomId            String
  title             String
  description       String
  assigneeId        String?
  column            String
  source            String
  agentReasoning    String?
  isApprovedByHuman Boolean?
  subtasks          Json
}

model ApiKey {
  id        String   @id @default(uuid())
  roomId    String
  provider  String
  key       String
  createdAt DateTime @default(now())

  @@unique([roomId, provider])
}
